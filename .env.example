# Claude data directory (host path for Docker volume mount)
CLAUDE_HOME=~/.claude

# Server
CT_PORT=4242

# File watching
# CT_WATCH_MODE overrides the settings DB value. Options: auto | native | poll
CT_WATCH_MODE=auto
# CT_POLL_INTERVAL overrides the settings DB value (ms, used when poll mode active)
# CT_POLL_INTERVAL=1000

# OTEL (optional)
CT_OTEL_ENABLED=false
CT_OTEL_PORT=4317
